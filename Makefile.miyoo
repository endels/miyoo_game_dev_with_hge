# Makefile.miyoo — thin wrapper over the unified CMake preset.
# Output: build-miyoo/bubble_level1
#
# Usage: make -f Makefile.miyoo

CMAKE ?= cmake

.PHONY: all configure clean
all:
	$(CMAKE) --preset miyoo-cross
	$(CMAKE) --build --preset miyoo-cross

configure:
	$(CMAKE) --preset miyoo-cross

clean:
	rm -rf build-miyoo
