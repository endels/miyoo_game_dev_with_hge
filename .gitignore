# Build outputs — one glob so a new build directory can never leak in.
# This is a safety net, not a licence: check `git status --short` before commit.
/build-*/
/CMakeFiles/
/CMakeCache.txt
CMakeUserPresets.json
*.o
*.d
*.a

# Deploy build outputs (per-game package, filled in by the deploy step)
/games/bubble/package/App/Bubble/bin/
/games/bubble/package/App/Bubble/bubble_libretro.so

# Generated / runtime files
/games/bubble/package/App/Bubble/ra_append.cfg
/games/bubble/package/App/Bubble/*.log
/games/bubble/package/App/Bubble/*.ppm
/games/bubble/package/App/Bubble/fb*.bin
*.log
*.ppm
fb*.bin
hello.ko

# Python cache
__pycache__/
*.py[cod]

# Generated BGM sources (rebuild with games/bubble/tools/make_bgm.py)
/games/bubble/tools/bgm/*.wav
!/games/bubble/tools/bgm/music_redo_chip.wav

# DSH agent handoff notes (local only)
/DSH-README.md
/docs/dsh-wsl-handoff.md
