# Makefile.libretro — thin wrapper over the unified CMake preset.
# Output: build-libretro/bubble_libretro.so
#
# Usage: make -f Makefile.libretro

CMAKE ?= cmake

.PHONY: all configure clean
all:
	$(CMAKE) --preset libretro-arm
	$(CMAKE) --build --preset libretro-arm

configure:
	$(CMAKE) --preset libretro-arm

clean:
	rm -rf build-libretro
